# ── Google Gemini (primary LLM) ──────────────────────────────────────────────
# Get it at: https://aistudio.google.com/app/apikey
# Free tier: yes. No credit card required.
GOOGLE_API_KEY=

# ── Groq (fallback LLM — Llama 3.3 70B) ─────────────────────────────────────
# Get it at: https://console.groq.com/keys
# Free tier: yes. No credit card required.
GROQ_API_KEY=

# ── Supabase (Postgres database) ─────────────────────────────────────────────
# Get both values at: https://supabase.com → your project → Settings → API
# Free tier: yes. No credit card required.
SUPABASE_URL=
SUPABASE_KEY=
